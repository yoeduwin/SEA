# ─────────────────────────────────────────────────────────────────────
# SEA — portales públicos en ejecutivambiental.com (HostGator / cPanel)
# Este archivo va dentro de /clientes y de /asesores (una copia en cada una).
# Lo genera scripts/empaquetar-hostgator.sh; no lo edites en el servidor.
# ─────────────────────────────────────────────────────────────────────

# Abrir index.html al entrar a la carpeta y no mostrar la lista de archivos
DirectoryIndex index.html
Options -Indexes

# Forzar HTTPS (reCAPTCHA no funciona bien sin él)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Solo se sirven las páginas y el script de reCAPTCHA; nada más
<FilesMatch "\.(gs|md|yml|yaml|json|sh|zip|bak|log|txt)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Seguridad básica
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Política de contenido (CSP): de dónde se puede cargar código y a dónde
  # se pueden mandar datos. Solo se permite lo que usan las páginas:
  #   - reCAPTCHA Enterprise (www.google.com, www.gstatic.com)
  #   - backend de Apps Script (script.google.com y su redirección a
  #     script.googleusercontent.com)
  # 'unsafe-inline' es necesario porque el código va dentro del HTML.
  # FASE DE PRUEBA: "Report-Only" solo avisa en la consola (F12), no bloquea.
  # Cuando las pruebas pasen, cambiar a "Content-Security-Policy".
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.gstatic.com https://www.google.com; font-src 'self' data:; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://www.google.com/recaptcha/; frame-src https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"

  # Que los navegadores siempre vean la versión más reciente al actualizar
  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
